# Copy to .env (which is git-ignored) and fill in. `shopify app dev` loads .env
# and passes these to the app server. Never commit real values.

# --- LLM -----------------------------------------------------------------
# "openai" (default) or "mock". Mock needs no key and returns canned replies,
# which is enough to test the widget -> proxy -> tool -> Shopify API pipeline.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# Optional: any OpenAI-compatible endpoint.
# OPENAI_BASE_URL=
# Optional: cap on tokens per model reply (default 1200).
# OPENAI_MAX_OUTPUT_TOKENS=1200

# --- Rate limits (optional; defaults shown) -------------------------------
# CHAT_LIMIT_PER_IP_PER_MINUTE=12
# CHAT_LIMIT_PER_SHOP_PER_HOUR=600
# CHAT_LIMIT_MERCHANT_PER_MINUTE=30

# SHOPIFY_API_KEY, SHOPIFY_API_SECRET, SHOPIFY_APP_URL and SCOPES are injected
# by `shopify app dev`. Set them yourself only when hosting the app.
