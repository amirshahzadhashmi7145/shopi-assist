// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop assistant configuration. One row per installed shop, created on first use.
model ShopSettings {
  shop               String   @id
  // Master switch for the storefront widget's backend.
  enabled            Boolean  @default(true)
  // Extra guidance from the merchant, appended to the shopper system prompt.
  instructions       String   @default("")
  // Opt-in: lets shoppers check an order's status with order number + checkout email.
  orderLookupEnabled Boolean  @default(false)
  // Conversations older than this are deleted.
  retentionDays      Int      @default(30)

  // What the merchant tells the assistant during setup. All optional: the
  // assistant already reads the catalog and published policies on its own.
  businessDescription String  @default("")
  returnPolicy        String  @default("")
  shippingInfo        String  @default("")
  faq                 String  @default("")
  // Shown in the widget header and used by the assistant to refer to itself.
  // Empty means "use the title set in the theme editor".
  assistantName       String  @default("")
  // First message in the widget. Empty means "use the theme editor's".
  greeting            String  @default("")
  // "friendly" | "professional" | "playful"
  tone                String  @default("friendly")

  // What the assistant is allowed to do for shoppers (ticked in setup).
  allowAddToCart      Boolean @default(true)
  allowCheckout       Boolean @default(true)
  // Opt-in: lets shoppers ask for a return with order number + checkout email.
  // It creates a return REQUEST that the merchant approves or declines.
  allowReturns        Boolean @default(false)
  // Opt-in: lets shoppers place a pay-on-delivery order from a form in the
  // chat. The app creates a real, unpaid order in the store.
  allowChatOrders     Boolean @default(false)

  // Quick policy picks from dropdowns. "" means "not set".
  returnWindow        String  @default("") // "none" | "7" | "14" | "30" | "60" | "90"
  returnShipping      String  @default("") // "customer" | "free"
  processingTime      String  @default("") // "same_day" | "1_2" | "3_5"
  deliveryTime        String  @default("") // "2_4" | "3_5" | "5_8" | "7_14"
  shipsTo             String  @default("") // "domestic" | "international"

  // Setup tour: opened automatically until it has been seen once.
  setupStartedAt      DateTime?
  setupCompletedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A chat thread. Every query against this table must filter by `shop`.
model Conversation {
  id         String    @id @default(cuid())
  shop       String
  // "shopper" (storefront widget) or "merchant" (admin assistant).
  audience   String
  // Random id generated by the widget (shopper) or the admin user id (merchant).
  visitorId  String
  // Shopify customer id when the shopper was logged in. Used for privacy redaction.
  customerId String?
  // True for the merchant's "try it as a shopper" chats in the admin. Set by
  // the server only; these are kept out of the shopper conversation log.
  isPreview  Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  orders     ConversationOrder[]

  @@index([shop, audience, updatedAt])
  @@index([shop, customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  // "user" or "assistant". Tool calls and tool results are never stored.
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// An order the shopper placed in this conversation, or proved is theirs by
// giving its number and checkout email. It lets the assistant answer follow-up
// questions about that order without asking for the email again. Holds no
// personal data, and is deleted with the conversation.
model ConversationOrder {
  id             String       @id @default(cuid())
  shop           String
  conversationId String
  // "gid://shopify/Order/123"
  orderId        String
  // "#1005"
  orderName      String
  // "placed" (through the chat's order form) or "verified" (number + email).
  source         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, orderId])
  @@index([shop])
}
