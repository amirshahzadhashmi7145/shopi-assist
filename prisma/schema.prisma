// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// Per-shop assistant configuration. One row per installed shop, created on first use.
model ShopSettings {
  shop               String   @id
  // Master switch for the storefront widget's backend.
  enabled            Boolean  @default(true)
  // Extra guidance from the merchant, appended to the shopper system prompt.
  instructions       String   @default("")
  // Opt-in: lets shoppers check an order's status with order number + checkout email.
  orderLookupEnabled Boolean  @default(false)
  // Opt-in on top of the above: basic status from the order number alone.
  // Less private, since order numbers can be guessed; tracking details and
  // return requests still need the checkout email.
  orderLookupByNumber Boolean @default(false)
  // Conversations older than this are deleted.
  retentionDays      Int      @default(30)

  // What the merchant tells the assistant during setup. All optional: the
  // assistant already reads the catalog and published policies on its own.
  businessDescription String  @default("")
  returnPolicy        String  @default("")
  shippingInfo        String  @default("")
  faq                 String  @default("")
  // Shown in the widget header and used by the assistant to refer to itself.
  // Empty means the app's default name (see settings.server.ts).
  assistantName       String  @default("")
  // First message in the widget. Empty means the app's default welcome.
  greeting            String  @default("")
  // The widget's colour, as "#" and six hex digits. Empty means the app's
  // default colour (see widget-look.ts).
  accentColor         String  @default("")
  // The corner of the page the widget sits in.
  widgetPosition      String  @default("right") // "right" | "left"

  // What the assistant is allowed to do with an existing order, each one
  // switched on by the merchant. (Adding to the cart and showing the way to
  // the checkout are not settings: every store has them.)
  // Opt-in: lets shoppers ask for a return with order number + checkout email.
  // It creates a return REQUEST that the merchant approves or declines.
  allowReturns        Boolean @default(false)
  // Opt-in changes to an existing order, each one only before the order starts
  // shipping, only for an order proved to be the shopper's, and only when the
  // shopper presses a confirm button in the chat.
  allowOrderCancel    Boolean @default(false)
  allowAddressChange  Boolean @default(false)
  allowOrderEdit      Boolean @default(false)
  // Opt-in: a shopper signed in to their store account gets their own recent
  // orders without giving an order number or email.
  recogniseCustomers  Boolean @default(false)
  // Shoppers can give the chat a thumbs-up or thumbs-down.
  chatRatings         Boolean @default(true)
  // What the form for a change of delivery address asks for. Shopify has the
  // same three options under Settings > Checkout but does not let apps read
  // them, so they are set here.
  orderFirstName      String  @default("optional") // "optional" | "required"
  orderCompany        String  @default("hidden")   // "hidden" | "optional" | "required"
  orderAddress2       String  @default("optional") // "hidden" | "optional" | "required"

  // Where "About the business" comes from: the store's own description in
  // Shopify ("shopify"), the merchant's words in businessDescription
  // ("custom"), or nothing ("none").
  aboutStore          String  @default("shopify")
  // Answers picked for common questions, as JSON: { "sizing": "small",
  // "hours": "custom:Weekdays 10 to 4" }. See setting-options.ts.
  topics              String  @default("{}")
  // What Shopify itself says about the store (where it ships, how shoppers
  // can pay, which policies are published), as JSON. Read from Shopify, never
  // typed by the merchant. See store-facts.ts.
  storeFacts          String  @default("{}")

  // Quick policy picks from dropdowns. "" means "not set".
  returnWindow        String  @default("") // "none" | "7" | "14" | "30" | "60" | "90"
  returnShipping      String  @default("") // "customer" | "free"
  processingTime      String  @default("") // "same_day" | "1_2" | "3_5"
  deliveryTime        String  @default("") // "2_4" | "3_5" | "5_8" | "7_14"
  shipsTo             String  @default("") // "domestic" | "international"
  // Comma-separated: "unused,packaging,tags,receipt,no_sale,no_custom".
  returnConditions    String  @default("")
  exchanges           String  @default("") // "yes" | "no"
  refundMethod        String  @default("") // "original" | "credit" | "either"
  shippingFee         String  @default("") // "free" | "free_over" | "flat" | "calculated"
  // The order amount for "free_over", or the rate for "flat", in the store's currency.
  shippingAmount      String  @default("")

  // Setup tour: opened automatically until it has been seen once.
  setupStartedAt      DateTime?
  setupCompletedAt    DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A chat thread. Every query against this table must filter by `shop`.
model Conversation {
  id         String    @id @default(cuid())
  shop       String
  // "shopper" (storefront widget) or "merchant" (admin assistant).
  audience   String
  // Random id generated by the widget (shopper) or the admin user id (merchant).
  visitorId  String
  // Shopify customer id when the shopper was logged in. Used for privacy redaction.
  customerId String?
  // True for the merchant's "try it as a shopper" chats in the admin. Set by
  // the server only; these are kept out of the shopper conversation log.
  isPreview  Boolean   @default(false)
  // The shopper's own verdict on the chat: "up" or "down". Null until they
  // give one. Written only by the rating endpoint, for their own chat.
  rating     String?
  ratedAt    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  messages   Message[]
  orders     ConversationOrder[]

  @@index([shop, audience, updatedAt])
  @@index([shop, customerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  // "user" or "assistant". Tool calls and tool results are never stored.
  role           String
  content        String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// An order the shopper placed in this conversation, or proved is theirs by
// giving its number and checkout email. It lets the assistant answer follow-up
// questions about that order without asking for the email again. Holds no
// personal data, and is deleted with the conversation.
model ConversationOrder {
  id             String       @id @default(cuid())
  shop           String
  conversationId String
  // "gid://shopify/Order/123"
  orderId        String
  // "#1005"
  orderName      String
  // "verified" (number plus email or phone). "placed" is on rows from when
  // the chat took pay-on-delivery orders itself; none are written any more.
  source         String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, orderId])
  @@index([shop])
}
